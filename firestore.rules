rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // A user can read/write their own document.
    // An admin or manager can list and read all user documents.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow list, get: if request.auth != null && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MANAGER'
      );
    }

    // Rules for the new, separate log collections.
    // This rule will match collections like 'weighing_records', 'gate_entry_records', etc.
    match /{collection}_records/{recordId} {
        // Any authenticated user can create a record entry.
        allow create: if request.auth != null;

        // Users can read their own records, and managers/admins can read all records.
        // This rule works for both direct reads and queries.
        allow read: if request.auth != null && (
            resource.data.userId == request.auth.uid ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN' ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'MANAGER'
        );
    }
  }
}
